{
  "name": "unseen",
  "private": true,
  "version": "0.1.0",
  "description": "UNSEEN — the 2026 grand-prix car, opened up. Interactive 3D physics explainer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "livery:shots": "node scripts/livery-shots.mjs",
    "audio:render": "node scripts/render-audio.mjs",
    "verify:clay": "node scripts/verify-clay.mjs",
    "verify:sound": "node scripts/verify-sound.mjs",
    "model": "node --max-old-space-size=8192 scripts/model/process.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "camera-controls": "3.1.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "puppeteer-core": "25.12.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
